# 后端服务地址（开发期默认指向远程 192.168.31.10）
# 服务端真实形态见 ARCHITECTURE.md §2
#   pt-game-server: JSON over WebSocket :10008，路径 /ws
#   pt-web-server : API（Sa-Token 鉴权），context-path /pt，controller /api/*
# 本地调试需覆盖时，复制本文件为 .env.local 并改值即可（.env.local 优先级更高）。

# 游戏 WS 端点（浏览器直连 remote）
VITE_GAME_WS_URL=ws://192.168.31.10:10008/ws

# HTTP API base（web-server，含 context-path /pt，不含 /api）
VITE_API_BASE=http://192.168.31.10:8080/pt

# 资产根（dev 阶段由 vite 中间件映射，生产指向部署位置）
VITE_ASSET_BASE=/res
