# 后端服务地址（pt-web-server HTTP API）
# WebSocket 端点由登录 API 动态返回，无需配置。
# 本地调试需覆盖时，复制本文件为 .env.local 并改值即可（.env.local 优先级更高）。
VITE_API_BASE=http://192.168.31.10:8080/pt

# 资产 URL 前缀（dev 由 vite 中间件映射 /res，生产指向部署位置）
VITE_ASSET_BASE=/res

# 资产本地根目录（dev 阶段 vite 中间件读取，build 后由部署服务器提供）
VITE_ASSET_ROOT=E:\JPsTale\client
